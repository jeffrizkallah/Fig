# Calendly personal access token, used to read real availability for the
# booking calendar in the contact section.
#
# Create one at: https://calendly.com/app/admin/integrations/api-webhooks
# Then copy this file to .env.local and paste the token below.
#
# Without it the calendar still works and bookings still complete — it just
# offers every weekday slot instead of only genuinely open ones.
CALENDLY_TOKEN=
